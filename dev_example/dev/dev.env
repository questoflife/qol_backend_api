# This file contains developer-specific environment variables.

# These settings override app.env and db.env.

# --- Default developer settings ---

# --- Additional user-defined settings ---

# Docker socket group id for /var/run/docker.sock access.
# Find it with:  stat -c %g /var/run/docker.sock
# Set that number below. Leave 0 if the socket is root:root (Docker Desktop).
# Example Linux host might output 998 (docker group) -> set DOCKER_GID=998
DOCKER_GID=0
