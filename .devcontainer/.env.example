# DevContainer Environment Variables
# Copy this file to .env (same directory) and customize for your system
# This file also serves as a guide to the environment variables needed.


# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# The values are placeholders, and are not needed for local development.
# They must exist though (or errors will occur)

# base URL of your frontend app
FRONTEND_ORIGIN=http://this-is-invalid-frontend  
# base URL of your backend API
API_BASE_URL=http://this-is-invalid-api
# where to go after login (success or failure)
LOGIN_REDIRECT=http://this-is-invalid-frontend/welcome 

# OAuth credentials for Discord login
DISCORD_CLIENT_ID=your_discord_client_oauth_id_here
DISCORD_CLIENT_SECRET=your_discord_client_oauth_secret_here

# Secret key for your application (used for sessions, etc) - can be anything
SECRET_KEY=your_apps_secret_key


# ============================================================================
# TESTING CONFIGURATION
# ============================================================================
RUN_INTEGRATION_TESTS=False


# ============================================================================
# Local Development
# ============================================================================
# Docker socket group ID for Docker-in-Docker access
# Find your system's GID with: stat -c %g /var/run/docker.sock
DOCKER_GID=1001


# ============================================================================
# DATABASE CONNECTION
# ============================================================================
# Your Python app uses these to connect to MySQL

# DB_HOST: Where to find the database
#   - In devcontainer: "db" (Docker service name)
#   - In production: Your cloud MySQL hostname
#   - If running locally outside Docker: "localhost"
DB_HOST=db

# DB_PORT: What port the database listens on
#   - In devcontainer: Must be 3306 (MySQL's container port, not configurable here)
#   - In production: Your cloud MySQL port (usually 3306)
DB_PORT=3306

DB_NAME=qol_dev_test_db  # Database name within MySQL
DB_USER=qol_user  # Database username
DB_PASSWORD=qol_pw  # Database user's password

# THIS MUST BE FALSE FOR PRODUCTION
DB_SSL_DISABLE_VERIFICATION=true  # Disable SSL verification for local dev

# ============================================================================
# MYSQL CONTAINER CONFIGURATION
# ============================================================================
# Only needed if running with-db (docker-compose files)
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=qol_dev_test_db
MYSQL_USER=qol_user
MYSQL_PASSWORD=qol_pw
